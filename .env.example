# Copy to .env (git-ignored) and set strong, unique values. Generate with: openssl rand -base64 24
VOIZY_ADMIN_DB_PASSWORD=
VOIZY_APP_DB_PASSWORD=
# Optional host ports (bound to 127.0.0.1 only)
# VOIZY_PG_PORT=5433
# VOIZY_API_PORT=8000

# Phase 2 (voice runtime). Put real values only in .env, never in chat or git.
# LiveKit Cloud dashboard -> your project -> Settings -> API Keys
# LIVEKIT_URL=wss://<your-project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
