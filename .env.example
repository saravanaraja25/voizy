# Copy to .env (git-ignored) and set strong, unique values. Generate with: openssl rand -base64 24
VOIZY_ADMIN_DB_PASSWORD=
VOIZY_APP_DB_PASSWORD=
# Optional host ports (bound to 127.0.0.1 only)
# VOIZY_PG_PORT=5433
# VOIZY_API_PORT=8000

# Encrypts stored integration keys and tool credentials (required).
# Generate with: uv run voizy-admin generate-secret-key   (copy the part after the =)
VOIZY_SECRET_KEYS=

# Phase 2 (voice runtime). LiveKit can also be connected in the dashboard instead of here. Put real values only in .env, never in chat or git.
# LiveKit Cloud dashboard -> your project -> Settings -> API Keys
# LIVEKIT_URL=wss://<your-project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Docker Compose (all optional) ---
# VOIZY_PORT=8080                       # the dashboard's port on 127.0.0.1
# VOIZY_PUBLIC_ORIGINS=https://voizy.example.com    # origins the dashboard is served from
# VOIZY_COOKIE_SECURE=1                 # set to 1 behind TLS (the compose default is 0 for localhost)
# VOIZY_SETUP_TOKEN=                    # choose the first-run token instead of reading it from the log
